# Expo and React Native resolve native modules and Babel/Metro plugins by
# walking node_modules directly, and neither copes with pnpm's default
# isolated symlink layout: transitive dependencies of `expo` (expo-asset,
# among others) are in the store but not resolvable from apps/mobile, so
# getDefaultConfig() throws before Metro can start.
#
# Expo's own monorepo guidance is to use a hoisted layout. This is what npm
# and yarn do by default; the cost is losing pnpm's strictness about
# undeclared dependencies, which is a smaller problem than the mobile app
# not booting.
node-linker=hoisted
