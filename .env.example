# ============================================================
# StudySpot environment template — copy to .env.local and fill in.
#
# Key-handling rules (OWASP A02/A05):
#  * NEVER commit real values; .env.local is gitignored.
#  * NEXT_PUBLIC_* / EXPO_PUBLIC_* vars ship to the BROWSER/APP.
#    Only the Supabase URL + anon key belong there (the anon key is
#    safe to expose ONLY because Row Level Security gates every table).
#  * Server-only secrets (service role, webhook/cron secrets) must
#    never get a NEXT_PUBLIC_/EXPO_PUBLIC_ prefix.
#  * Rotate keys after any suspected leak: Supabase Dashboard →
#    Settings → API → "Reset" (then update Vercel env + Edge Function
#    secrets + this file's local copy).
# ============================================================

# Supabase (public — protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (SERVER-ONLY — full database access, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge Function shared secrets (server-only).
# Generate each with:  openssl rand -base64 32
# Set on Supabase with: supabase secrets set WEBHOOK_SECRET=... CRON_SECRET=...
# WEBHOOK_SECRET must also be added as the `x-webhook-secret` HTTP header on
# the Database Webhooks; CRON_SECRET as `x-cron-secret` on the cron triggers.
WEBHOOK_SECRET=generate-a-random-32-char-secret
CRON_SECRET=generate-a-different-random-32-char-secret
# Optional: comma-separated browser origins allowed to call Edge Functions.
ALLOWED_ORIGINS=http://localhost:3000,https://web-livid-two-79.vercel.app

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
GOOGLE_MAPS_SERVER_KEY=your-server-maps-key

# Expo (mobile)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email
RESEND_API_KEY=your-resend-key

# Push notifications
EXPO_ACCESS_TOKEN=your-expo-token

# Web Push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe in the browser — it only identifies the sender; the
# private key SIGNS pushes and is server-only (set it as an Edge Function
# secret, never with a NEXT_PUBLIC_ prefix).
# Set on Supabase with:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=...
# Both keys must be the SAME pair in the browser and the functions, or push
# services reject every send.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact the push service can use to reach you about a misbehaving sender
# (RFC 8292 requires it): mailto: or https:
VAPID_SUBJECT=mailto:admin@studyspot.app

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Admin
ADMIN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
ADMIN_EMAILS=admin@studyspot.app
